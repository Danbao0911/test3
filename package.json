{
  "name": "test3-account-workbench",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "setup:local": "tsx scripts/setup-local.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "user:create": "tsx scripts/create-user.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "retention:cleanup": "tsx scripts/retention-maintenance.ts cleanup",
    "retention:replay": "tsx scripts/retention-maintenance.ts replay",
    "t10:preflight": "tsx scripts/t10-preflight.ts",
    "t10:recovery:drill": "tsx scripts/t10-recovery-drill.ts",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "next": "16.3.5",
    "papaparse": "5.7.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.3",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
