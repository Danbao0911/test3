generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SourceType {
  DEMO
  AUTHORIZED_MANUAL
}

enum SourceStatus {
  DRAFT
  APPROVED
  REVOKED
}

enum Platform {
  XIAOHONGSHU
  YOUTUBE
  X
  DOUYIN
}

enum ImportRowStatus {
  CREATED
  DUPLICATE
  INVALID
}

enum UserRole {
  ADMIN
  REVIEWER
  VIEWER
}

enum ContactType {
  EMAIL
  WECHAT
  PHONE
  CONTACT_URL
  BOOKING_URL
}

enum ContactStatus {
  PENDING
  APPROVED
  REJECTED
  INVALID
}

enum FollowUpStatus {
  NOT_CONTACTED
  CONTACTING
  REPLIED
  NOT_MATCH
  DO_NOT_CONTACT
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique @db.VarChar(320)
  passwordHash  String
  role          UserRole       @default(VIEWER)
  createdAt     DateTime       @default(now())
  sessions      Session[]
  importBatches  ImportBatch[]
  reviews        ReviewDecision[]
  auditEvents    AuditEvent[]
  policyChanges  Source[]       @relation("PolicyActor")
  policySnapshots SourcePolicySnapshot[] @relation("PolicySnapshotActor")
  ownedAccounts  Account[]      @relation("AccountOwner")
  favorites      AccountFavorite[]
  followUpUpdates AccountFollowUp[] @relation("FollowUpUpdater")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique @db.VarChar(64)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model LoginThrottle {
  id              String   @id @default(uuid()) @db.Uuid
  keyHash         String   @unique @db.VarChar(64)
  attemptCount    Int      @default(0)
  windowStartedAt DateTime
  updatedAt       DateTime @updatedAt

  @@index([updatedAt])
}

model Source {
  id             String       @id @default(uuid()) @db.Uuid
  name           String       @db.VarChar(160)
  type           SourceType
  status         SourceStatus @default(DRAFT)
  permissionNote String       @default("") @db.VarChar(2000)
  allowImport    Boolean      @default(false)
  allowExtract   Boolean      @default(false)
  allowEvidenceText Boolean   @default(false)
  retentionDays  Int          @default(30)
  policyVersion  Int          @default(1)
  policyChangedById String?   @db.Uuid
  policyChangedBy User?       @relation("PolicyActor", fields: [policyChangedById], references: [id], onDelete: Restrict)
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  accounts       Account[]
  importBatches  ImportBatch[]
  evidence       Evidence[]
  policySnapshots SourcePolicySnapshot[]

  @@index([status, allowImport])
  @@index([expiresAt])
}

model Account {
  id                    String      @id @default(uuid()) @db.Uuid
  platform              Platform
  nativeId              String?     @db.VarChar(200)
  displayName           String      @db.VarChar(120)
  profileUrl            String      @db.VarChar(2048)
  normalizedProfileUrl  String      @db.VarChar(2048)
  organization          String?     @db.VarChar(200)
  serviceTags           String[]    @db.Text
  region                String?     @db.VarChar(100)
  sourceId              String      @db.Uuid
  sourceUrl             String      @db.VarChar(2048)
  capturedAt            DateTime
  isDemo                Boolean     @default(false)
  ownerId               String?     @db.Uuid
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  source                Source      @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  owner                 User?       @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  importRowResults      ImportRowResult[]
  evidence              Evidence[]
  favorites             AccountFavorite[]
  followUp              AccountFollowUp?

  @@unique([platform, normalizedProfileUrl])
  @@unique([platform, nativeId])
  @@index([platform, createdAt, id])
  @@index([sourceId, createdAt])
  @@index([ownerId, createdAt])
}

model AccountFavorite {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, userId])
  @@index([userId, createdAt])
}

model AccountFollowUp {
  id          String       @id @default(uuid()) @db.Uuid
  accountId   String       @unique @db.Uuid
  status      FollowUpStatus @default(NOT_CONTACTED)
  note        String       @default("") @db.VarChar(1000)
  updatedById String?      @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  updatedBy   User?       @relation("FollowUpUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
}

model ImportBatch {
  id              String            @id @default(uuid()) @db.Uuid
  createdById     String            @db.Uuid
  sourceId        String            @db.Uuid
  idempotencyKey  String            @db.VarChar(200)
  payloadHash     String            @db.VarChar(64)
  totalRows       Int
  createdCount    Int               @default(0)
  duplicateCount  Int               @default(0)
  invalidCount    Int               @default(0)
  createdAt       DateTime          @default(now())
  createdBy       User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  source          Source            @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  rows            ImportRowResult[]

  @@unique([createdById, idempotencyKey])
  @@index([createdById, createdAt])
  @@index([sourceId, createdAt])
}

model ImportRowResult {
  id           String          @id @default(uuid()) @db.Uuid
  batchId      String          @db.Uuid
  rowNumber    Int
  status       ImportRowStatus
  accountId    String?         @db.Uuid
  errorCode    String?         @db.VarChar(80)
  errorMessage String?         @db.VarChar(500)
  batch        ImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  account      Account?        @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
}

// One immutable record per source policy version. Legacy rows intentionally carry
// nullable capability fields and isLegacy=true because their historical grant is unknown.
model SourcePolicySnapshot {
  id                String   @id @default(uuid()) @db.Uuid
  sourceId          String   @db.Uuid
  version           Int
  status            SourceStatus?
  allowImport       Boolean?
  allowExtract      Boolean?
  allowEvidenceText Boolean?
  retentionDays     Int?
  expiresAt         DateTime?
  permissionNote    String?  @db.VarChar(2000)
  authorizationBasis String  @db.VarChar(2000)
  changedById       String?  @db.Uuid
  recordedAt        DateTime @default(now())
  changeType        String   @db.VarChar(50)
  isLegacy          Boolean  @default(false)
  source            Source   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  changedBy         User?    @relation("PolicySnapshotActor", fields: [changedById], references: [id], onDelete: Restrict)
  evidence          Evidence[]

  @@unique([sourceId, version])
  @@index([sourceId, recordedAt])
}

// Immutable, field-specific excerpts only; full input text is never persisted.
model Evidence {
  id              String   @id @default(uuid()) @db.Uuid
  accountId       String   @db.Uuid
  sourceId        String   @db.Uuid
  policyVersion   Int
  policySnapshotId String   @db.Uuid
  sourceUrl       String   @db.VarChar(2048)
  capturedAt      DateTime
  fieldLocation   String   @db.VarChar(240)
  excerpt         String   @db.VarChar(300)
  createdAt       DateTime @default(now())
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  source          Source   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  policySnapshot  SourcePolicySnapshot @relation(fields: [policySnapshotId], references: [id], onDelete: Restrict)
  contact         ContactPoint?

  @@index([accountId, createdAt])
  @@index([sourceId, policyVersion])
}

model ContactPoint {
  id                  String        @id @default(uuid()) @db.Uuid
  evidenceId          String        @unique @db.Uuid
  dedupeKey           String        @unique @db.VarChar(64)
  type                ContactType
  rawValue            String        @db.VarChar(2048)
  normalizedValue     String        @db.VarChar(2048)
  status              ContactStatus @default(PENDING)
  ownershipConfirmed  Boolean       @default(false)
  businessConfirmed   Boolean       @default(false)
  version             Int           @default(1)
  expiresAt           DateTime
  reviewedAt          DateTime?
  createdAt           DateTime      @default(now())
  evidence            Evidence      @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  reviews             ReviewDecision[]

  @@index([status, createdAt, id])
  @@index([expiresAt])
}

model ReviewDecision {
  id                  String        @id @default(uuid()) @db.Uuid
  contactId           String        @db.Uuid
  reviewerId          String        @db.Uuid
  status              ContactStatus
  reason              String        @db.VarChar(500)
  ownershipConfirmed  Boolean
  businessConfirmed   Boolean
  version             Int
  createdAt           DateTime      @default(now())
  contact             ContactPoint  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  reviewer            User          @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@unique([contactId, version])
}

// Deliberately no arbitrary JSON, contact values, evidence text or free-text reasons.
model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String   @db.Uuid
  action      String   @db.VarChar(50)
  targetId    String   @db.Uuid
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
}
